{
  "name": "dmns-field-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build && tsx scripts/dev.ts",
    "serve": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts && tsc -p tsconfig.browser.json && tsx scripts/check-budgets.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build && tsx scripts/check-contrast.ts && tsx scripts/check-links.ts && tsx scripts/check-reading-order.ts && npm run test:e2e",
    "record": "tsx scripts/record.ts",
    "audit": "tsx scripts/audit.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.39.0",
    "lighthouse": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "zod": "^4.1.0"
  }
}
